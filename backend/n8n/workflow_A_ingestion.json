{
  "name": "Frugal AI - Workflow A - Ingestion RAG",
  "id": "aaaaaaaa-a000-4000-a000-000000000001",
  "active": false,
  "settings": { "executionOrder": "v1", "saveManualExecutions": true, "callerPolicy": "workflowsFromSameOwner" },
  "tags": [{ "name": "frugal-ai" }],
  "nodes": [
    {
      "id": "a0000001-0000-0000-0000-000000000001",
      "name": "Declencheur Manuel",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 300],
      "parameters": {}
    },
    {
      "id": "a0000001-0000-0000-0000-000000000002",
      "name": "Config: Constantes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [200, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const CONFIG = {\n  SUPABASE_URL: 'http://host.docker.internal:8000/rest/v1',\n  SUPABASE_KEY: 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE',\n  OLLAMA_URL: 'http://host.docker.internal:11434',\n  OCR_URL: 'http://frugalai-ocr:3100',\n  EMBEDDING_MODEL: 'nomic-embed-text',\n  CHUNK_SIZE: 500,\n  CHUNK_OVERLAP: 50\n};\nreturn [{ json: CONFIG }];"
      }
    },
    {
      "id": "a0000001-0000-0000-0000-000000000003",
      "name": "Lister les PDFs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config: Constantes').all()[0].json.OCR_URL + '/list' }}",
        "options": { "timeout": 15000 }
      }
    },
    {
      "id": "a0000001-0000-0000-0000-000000000004",
      "name": "Parser la Liste de Fichiers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const resp = $input.all()[0].json;\nconst files = (resp.files || []);\nif (files.length === 0) throw new Error('Aucun PDF trouve dans /data/pdfs');\nreturn files.map(f => ({ json: { fileName: f } }));"
      }
    },
    {
      "id": "a0000001-0000-0000-0000-000000000005",
      "name": "Traiter PDF par PDF",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [800, 300],
      "parameters": { "batchSize": 1, "options": {} }
    },
    {
      "id": "a0000001-0000-0000-0000-000000000006",
      "name": "HTTP: Extraire Texte OCR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 300],
      "continueOnFail": true,
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config: Constantes').all()[0].json.OCR_URL + '/extract' }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filename: $json.fileName }) }}",
        "options": { "timeout": 300000 }
      }
    },
    {
      "id": "a0000001-0000-0000-0000-000000000007",
      "name": "Detection Type + Decoupage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst out = [];\nfor (const it of items) {\n  const ocrResp = it.json || {};\n  if (ocrResp.error) { continue; }\n  const text = ocrResp.text || '';\n  const meta = ocrResp.metadata || {};\n  const ocr_used = ocrResp.ocr_used || false;\n  const filename = ocrResp.filename || 'unknown';\n  const words = text.split(/\\s+/).filter(w => w.length > 0);\n  const CHUNK_SIZE = 300, OVERLAP = 40;\n  let count = 0;\n  for (let i = 0; i < words.length; i += CHUNK_SIZE - OVERLAP) {\n    const w = words.slice(i, i + CHUNK_SIZE);\n    if (w.length < 10) break;\n    out.push({ json: { contenu: w.join(' '), source_pdf: filename, metadata: { chunk_index: count, word_start: i, ocr_used, pdf_title: meta.title || '', pdf_author: meta.author || '', pdf_pages: meta.pages || 0 } } });\n    count++;\n  }\n}\nreturn out;"
      }
    },
    {
      "id": "a0000001-0000-0000-0000-000000000008",
      "name": "Traiter Chunk par Chunk",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1400, 300],
      "parameters": { "batchSize": 1, "options": {} }
    },
    {
      "id": "a0000001-0000-0000-0000-000000000009",
      "name": "HTTP: Embedding Ollama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1600, 300],
      "continueOnFail": true,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:11434/api/embeddings",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Config: Constantes').all()[0].json.EMBEDDING_MODEL, prompt: $json.contenu }) }}",
        "options": { "timeout": 60000 }
      }
    },
    {
      "id": "a0000001-0000-0000-0000-000000000010",
      "name": "Combiner Chunk + Embedding",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1800, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const embs = $input.all();\nconst chunks = $('Detection Type + Decoupage').all();\nconst out = [];\nfor (let i = 0; i < embs.length; i++) {\n  const embedding = (embs[i].json || {}).embedding;\n  const chunk = (chunks[i] && chunks[i].json) || {};\n  if (!embedding || !Array.isArray(embedding)) { continue; }\n  const embeddingStr = '[' + embedding.join(',') + ']';\n  out.push({ json: { contenu: chunk.contenu, embedding: embeddingStr, source_pdf: chunk.source_pdf, metadata: chunk.metadata } });\n}\nreturn out;"
      }
    },
    {
      "id": "a0000001-0000-0000-0000-000000000011",
      "name": "HTTP: Inserer Chunk Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config: Constantes').all()[0].json.SUPABASE_URL + '/chunks' }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Content-Type", "value": "application/json" },
          { "name": "apikey", "value": "={{ $('Config: Constantes').all()[0].json.SUPABASE_KEY }}" },
          { "name": "Authorization", "value": "=Bearer {{ $('Config: Constantes').all()[0].json.SUPABASE_KEY }}" },
          { "name": "Prefer", "value": "return=minimal" }
        ]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contenu: $json.contenu, embedding: $json.embedding, source_pdf: $json.source_pdf, metadata: $json.metadata }) }}",
        "options": { "timeout": 30000 }
      }
    },
    {
      "id": "a0000001-0000-0000-0000-000000000012",
      "name": "Afficher Resultat",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2200, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconsole.log('Ingestion terminee : ' + items.length + ' chunks inseres');\nreturn [{ json: { status: 'success', chunks_inseres: items.length } }];"
      }
    }
  ],
  "connections": {
    "Declencheur Manuel": { "main": [[{ "node": "Config: Constantes", "type": "main", "index": 0 }]] },
    "Config: Constantes": { "main": [[{ "node": "Lister les PDFs", "type": "main", "index": 0 }]] },
    "Lister les PDFs": { "main": [[{ "node": "Parser la Liste de Fichiers", "type": "main", "index": 0 }]] },
    "Parser la Liste de Fichiers": { "main": [[{ "node": "Traiter PDF par PDF", "type": "main", "index": 0 }]] },
    "Traiter PDF par PDF": { "main": [
      [{ "node": "Afficher Resultat", "type": "main", "index": 0 }],
      [{ "node": "HTTP: Extraire Texte OCR", "type": "main", "index": 0 }]
    ] },
    "HTTP: Extraire Texte OCR": { "main": [[{ "node": "Detection Type + Decoupage", "type": "main", "index": 0 }]] },
    "Detection Type + Decoupage": { "main": [[{ "node": "HTTP: Embedding Ollama", "type": "main", "index": 0 }]] },
    "HTTP: Embedding Ollama": { "main": [[{ "node": "Combiner Chunk + Embedding", "type": "main", "index": 0 }]] },
    "Combiner Chunk + Embedding": { "main": [[{ "node": "HTTP: Inserer Chunk Supabase", "type": "main", "index": 0 }]] },
    "HTTP: Inserer Chunk Supabase": { "main": [[{ "node": "Traiter PDF par PDF", "type": "main", "index": 0 }]] }
  }
}