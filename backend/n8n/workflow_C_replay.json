                  {
                      "id":  "c000-0006",
                      "name":  "Code: Construire Réponse Replay",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       1000,
                                       300
                                   ],
                      "parameters":  {
                                         "mode":  "runOnceForAllItems",
                                         "jsCode":  "const PROFILS = [\n  {min:24,max:42,nom:\u0027Souveraineté et sobriété radicales\u0027},\n  {min:43,max:60,nom:\u0027Régulation et changement de cap\u0027},\n  {min:61,max:78,nom:\u0027Pragmatisme et mix équilibré\u0027},\n  {min:79,max:96,nom:\u0027Confiance technologique et innovation\u0027}\n];\n\nconst rawSession = $(\u0027HTTP: Récupérer Session\u0027).all()[0].json;\nconst session = Array.isArray(rawSession) ? rawSession[0] : rawSession;\n\nconst rawMessages = $(\u0027HTTP: Récupérer Messages\u0027).all()[0].json;\nconst messages = Array.isArray(rawMessages) ? rawMessages : [];\n\nconst rawScores = $input.all()[0].json;\nconst scores = Array.isArray(rawScores) ? rawScores : [];\n\nconst scoreFinal = session ? (session.score_final || null) : null;\nconst profil = scoreFinal ? (PROFILS.find(p =\u003e scoreFinal \u003e= p.min \u0026\u0026 scoreFinal \u003c= p.max) || null) : null;\n\nreturn [{\n  json: {\n    session: session || null,\n    messages: messages,\n    scores: scores,\n    score_final: scoreFinal,\n    profil: profil ? profil.nom : null\n  }\n}];"
                                     }
