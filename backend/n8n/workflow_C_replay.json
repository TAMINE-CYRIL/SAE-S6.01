                      "parameters":  {
                                         "mode":  "runOnceForAllItems",
                                         "jsCode":  "const CONFIG = {\n  SUPABASE_URL: \u0027http://host.docker.internal:8000\u0027,\n  SUPABASE_KEY: \u0027eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE\u0027\n};\nconst query = $input.all()[0].json.query || {};\nconst sessionId = query.session_id || null;\nif (!sessionId) {\n  throw new Error(\u0027Paramètre session_id manquant. Usage: GET /webhook/frugalai-replay?session_id=\u003cuuid\u003e\u0027);\n}\nreturn [{ json: { ...CONFIG, session_id: sessionId } }];"
