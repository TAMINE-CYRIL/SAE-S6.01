# ─── Frugal AI — Variables d'environnement ───────────────────────────────────
# Copier ce fichier en .env et remplir les valeurs.

# Clé de chiffrement n8n (chaîne aléatoire, ne pas partager)
N8N_ENCRYPTION_KEY=frugalai-secret-key-change-in-production

# ─── Supabase local ──────────────────────────────────────────────────────────
# Récupérer ces clés dans : http://localhost:3000 > Settings > API
# (ou dans supabase-local/docker/.env)
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# ─── PostgreSQL direct (pour les nœuds Postgres n8n) ─────────────────────────
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── Modèles Ollama ──────────────────────────────────────────────────────────
# Modèle principal de l'IA frugaliste
FRUGALISTE_MODEL=mistral

# Modèle d'embedding (obligatoire : nomic-embed-text)
EMBEDDING_MODEL=nomic-embed-text

# Chemin local des modèles Ollama (adapter sur un nouveau PC,
# ou laisser vide pour utiliser un volume Docker dédié)
OLLAMA_DATA_PATH=C:/Users/<utilisateur>/.ollama
